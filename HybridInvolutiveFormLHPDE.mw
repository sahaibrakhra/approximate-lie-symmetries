ApSys:=[];
for i from 1 to nops(JetSys) do 
	JetVars := indets(JetSys[i]);
	Coeffs:=[];
	for j from 1 to nops(JetVars) do 
		Coeffs := [op(Coeffs), coeff(lhs(JetSys[i]), JetVars[j])];
	end do;
	lprint(Coeffs);
	BB:= [seq(whattype(Coeffs[k]), k=1..nops(Coeffs))];
	lprint(BB);
	if has(BB, float)  then
		ApSys := [op(ApSys), JetSys[i]];
	else 
		ExSys := [op(ExSys), JetSys[i]];
	end if;
end do;
ApSys := PDETools:-FromJet(ApSys,([seq(deps[i], i = 1 .. nops(deps))])(op(indeps)));
ExSys := PDETools:-FromJet(ExSys,([seq(deps[i], i = 1 .. nops(deps))])(op(indeps)));
rExSys := DEtools:-rifsimp(ExSys);
IDExSys := DEtools:-initialdata(rExSys);
HFExSys := DifferentialHilbertFunction(IDExSys, s);
SimpApSys := PDEtools:-dsubs(rExSys[Solved], ApSys);
lprint(SimpApSys);
q2 := difforder(SimpApSys);
			
		
