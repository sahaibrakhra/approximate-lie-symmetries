</Group></Presentation-Block><Presentation-Block><CodeEditor-ExecGroup view="presentation" hide-input="false" inline-output="false" labelreference="L8157" drawlabel="true" applyint="true" applyrational="true" display="code"><EC-CodeEditor id="CodeEditRegion5" expanded="true" visible="true" pixel-width="500" pixel-height="200" code-language="text/maple" autofit="true" wrapping="true" show-border="true" code-line-numbers="true">Inside := [];
Onbound := [];
for m from 1 to nops(DleastComMDep) do 
	DLCM := PDEtools:-dsubs(rExSys[Solved],DleastComMDep[m] );
	lprint(`DLCM =`,DLCM);
	if DLCM &lt;&gt; DleastComMDep[m] then
		PLCM := PolynomialTools:-PDEToPolynomial([DLCM], vars[1], vars[2]);
		lprint(`PLCM =`, PLCM);
		Onbound := [op(Onbound), DleastComMDep[m] ];
		#lprint(`Onbound after subtracking one degree of indep variables =` , Onbound);
	else 
		Inside := [op(Inside), DleastComMDep[m] ];
		lprint(`Inside after subtracking one degree of indep variables =` , Inside);
		end if;
end do;</EC-CodeEditor>
