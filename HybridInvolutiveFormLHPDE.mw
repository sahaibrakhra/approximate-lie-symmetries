for l from 1 to nops(DleastComMDep) do 
	DLCM := PDEtools:-dsubs(rExSys[Solved],DleastComMDep[l] );
	if DLCM &lt;&gt; DleastComMDep[l] then
		PLCM := PolynomialTools:-PDEToPolynomial([DLCM], vars[1], vars[2]);
		Interior := [op(Interior), DleastComMDep[l] ];
		lprint(`Interior =` , Interior);
	else 
		NonInterior := [op(NonInterior), DleastComMDep[l] ];
		lprint(`NonInterior =` , NonInterior);
	end if;
end do;
LowerdegreeDep := PDEtools:-difforder(NonInterior);
